# Frontend (Vite) — copy values into `.env` / `.env.local`
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Pack catalog artifact host is configured in src-tauri/remined.config.json
# (GitHub Releases catalog.json). Pack *copy/UI* lives in Supabase `packs` table.

# Optional local tooling (never commit real secrets)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# SUPABASE_DB_PASSWORD=
