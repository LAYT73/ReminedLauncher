{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remined",
  "version": "1.0.2",
  "identifier": "com.remined.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Remined",
        "width": 1280,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--proxy-bypass-list=<-loopback>;localhost;127.0.0.1;::1;*.local"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: wss: ws: http://127.0.0.1:* http://localhost:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NTIxQTY0M0M1NkQxNjMKUldSajBWWThaQnBTNUlVQlJ1Z1dlaVFPT2o5YkJwdVdvdTJOSUdyd0ltYWVmMmFrRzJ2TERhU1oK",
      "endpoints": [
        "https://github.com/LAYT73/ReminedLauncher/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
